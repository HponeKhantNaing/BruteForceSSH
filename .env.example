# Copy to .env for local use. Never commit the real .env file.
# No secrets belong in git or in config YAML.

# --- P1: Ubuntu Docker lab SSH (project-owned container only) ---
LAB_SSH_USER=testuser
LAB_SSH_PASSWORD=change_me_for_local_lab
LAB_SSH_PORT=2222

# --- P12: Discord alerting ---
# Leave disabled for local dashboard-only use.
P12_DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
